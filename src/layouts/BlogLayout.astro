---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  readTime: string;
  publishedDate?: string;
  datePublished?: string; // ISO date, e.g. '2026-11-11'
  dateModified?: string; // ISO date; defaults to datePublished when that is set
  related?: { href: string; label: string }[];
}

const {
  title,
  description,
  category,
  readTime,
  datePublished,
  dateModified,
  related = [],
} = Astro.props;

// Articles published before per-article dates existed keep their original dates.
const isoPublished = datePublished ?? '2026-06-01';
const isoModified = dateModified ?? datePublished ?? '2026-08-10';
const displayModified = new Date(`${isoModified}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Article + BreadcrumbList structured data
const canonicalUrl = new URL(Astro.url.pathname, 'https://asbuiltcompany.com').href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: description,
      articleSection: category,
      author: {
        '@type': 'Organization',
        name: 'As-Built Company',
        url: 'https://asbuiltcompany.com',
      },
      publisher: {
        '@id': 'https://asbuiltcompany.com/#organization',
      },
      datePublished: isoPublished,
      dateModified: isoModified,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://asbuiltcompany.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Resources',
          item: 'https://asbuiltcompany.com/resources/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---
<BaseLayout
  title={`${title} — As-Built Company`}
  description={description}
  jsonLd={articleJsonLd}
>
  <section class="blog-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/resources/">Resources</a> · {category}
      </div>
      <span class="meta-label">{category}</span>
      <h1>{title}</h1>
      <p class="meta">By As-Built Company · {readTime} read · Updated <time datetime={isoModified}>{displayModified}</time></p>
    </div>
  </section>

  <article class="blog-body">
    <div class="container">
      <slot />

      {related.length > 0 && (
        <div class="callout">
          <div class="callout-title">Keep reading</div>
          <ul style="margin-bottom: 0;">
            {related.map((r) => (
              <li><a href={r.href}>{r.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      <hr />

      <div style="text-align: center; margin-top: 2rem;">
        <p style="color: var(--color-muted); margin-bottom: 1rem;">Have a project where this applies?</p>
        <a href="/contact/" class="btn">Get a Quote <span class="arrow">→</span></a>
      </div>
    </div>
  </article>
</BaseLayout>
