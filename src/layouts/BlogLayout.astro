---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  readTime: string;
  publishedDate?: string;
}

const { title, description, category, readTime, publishedDate = 'June 2026' } = Astro.props;

// Article + BreadcrumbList structured data
const canonicalUrl = new URL(Astro.url.pathname, 'https://asbuiltcompany.com').href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: description,
      articleSection: category,
      author: {
        '@type': 'Organization',
        name: 'As-Built Company',
        url: 'https://asbuiltcompany.com',
      },
      publisher: {
        '@id': 'https://asbuiltcompany.com/#organization',
      },
      datePublished: '2026-06-01',
      dateModified: '2026-08-10',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://asbuiltcompany.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Resources',
          item: 'https://asbuiltcompany.com/resources/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---
<BaseLayout
  title={`${title} — As-Built Company`}
  description={description}
  jsonLd={articleJsonLd}
>
  <section class="blog-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/resources/">Resources</a> · {category}
      </div>
      <span class="meta-label">{category}</span>
      <h1>{title}</h1>
    </div>
  </section>

  <article class="blog-body">
    <div class="container">
      <slot />

      <hr />

      <div style="text-align: center; margin-top: 2rem;">
        <p style="color: var(--color-muted); margin-bottom: 1rem;">Have a project where this applies?</p>
        <a href="/contact/" class="btn">Get a Quote <span class="arrow">→</span></a>
      </div>
    </div>
  </article>
</BaseLayout>
