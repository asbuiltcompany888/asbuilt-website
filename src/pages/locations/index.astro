---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CITIES } from '../../data/cities';
import { COUNTIES } from '../../data/counties';

const title = 'Locations We Serve, 3D Laser Scanning Nationwide | As-Built Company';
const description = 'As-Built Company provides 3D laser scanning and as-built documentation across every county in Southern California and major metros nationwide, from Los Angeles and San Diego to Phoenix, Las Vegas, Seattle, and Dallas–Fort Worth.';

const regionName = (r: string) =>
  r === 'CA' ? 'California' : r === 'AZ' ? 'Arizona' : r === 'NV' ? 'Nevada' : r === 'WA' ? 'Washington' : r === 'TX' ? 'Texas' : r;
---
<BaseLayout title={title} description={description}>
  <section class="hero hero-compact">
    <div class="container">
      <div class="eyebrow">Locations</div>
      <h1>3D scanning, <span class="accent">nationwide.</span></h1>
      <p class="lead">Our home base is Southern California, where we cover every county, and we scan projects across the country. Explore your county or city below, or reach out about a site anywhere in the U.S.</p>
    </div>
  </section>

  {/* Southern California, by county */}
  <section>
    <div class="container">
      <div class="section-title-centered reveal">
        <span class="eyebrow">Southern California</span>
        <h2>Every county, covered</h2>
        <p>We serve all ten Southern California counties. Choose yours for local coverage and the cities we scan most.</p>
      </div>
      <div class="grid grid-3 reveal-stagger">
        {COUNTIES.map((county) => (
          <a href={`/locations/counties/${county.slug}/`} class="industry-card">
            <div class="industry-icon">◎</div>
            <h3>{county.name}</h3>
            <p>3D scanning &amp; as-built documentation across {county.name}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Cities with dedicated pages */}
  <section class="section-surface">
    <div class="container">
      <div class="section-title-centered reveal">
        <span class="eyebrow">Cities We Serve</span>
        <h2>Local pages, city by city</h2>
      </div>
      <div class="reveal" style="max-width: 860px; margin: 1.5rem auto 0; text-align: center; line-height: 2.4;">
        {CITIES.map((city, i) => (
          <span>
            <a href={`/locations/${city.slug}/`}>{city.name}</a>
            <span style="color: var(--color-muted);">{i < CITIES.length - 1 ? '  ·  ' : ''}</span>
          </span>
        ))}
      </div>
      <p class="reveal" style="text-align: center; color: var(--color-muted); margin-top: 1.5rem;">
        Nationwide coverage also includes the San Francisco Bay Area, Sacramento, Phoenix, Las Vegas, Seattle, and Dallas–Fort Worth.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="cta-strip reveal">
        <div class="text">
          <h3>Don&rsquo;t see your city?</h3>
          <p>We travel nationwide. Tell us your project address and we&rsquo;ll confirm coverage.</p>
        </div>
        <a href="/contact/" class="btn">Get a Quote <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
